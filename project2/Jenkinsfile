pipeline {
    agent any
    stages {
        stage('Source SCM Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Shreemathi07/Student-Management-DevOps-24mis0008-.git'
            }
        }
        stage ('Parallel Verification Tasks') {
            parallel {
                stage ('Verify Student Registries') {
                    steps {
                        dir('project2') {
                            bat 'python verify_students.py'
                        }
                    }
                }
                stage ('Verify Academic Balances') {
                    steps {
                        dir('project2') {
                            bat 'python verify_grades.py'
                        }
                    }
                }
            }
        }
    }
}
